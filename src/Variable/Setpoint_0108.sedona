@niagaraIcon="module://icons/x16/control/numericPoint.png"
class Setpoint
  extends Component
{
  @config @asStr
  property Buf(32) url = ""

  @asStr
  @readonly
  property Buf(32) pointName = ""

  @readonly
  property float out = 0.0f

  property float in = 0.0f

  override void start()
  {
    // Runtime.load()
    if (url.toStr().length() > 0) {
      pointName.clear()
      pointName.copyFromStr(url.toStr())
      file.name = pointName.toStr()
      log.message("start Setpoint::file.name=${pointName.toStr()}")
      // ctx = Runtime.dataOpen(pointName.toStr())
      if (file.open("r")) {
           // Runtime.dataRead(ctx, buf)
           file.in.readBytes(fileBuf, 4, 4)
           dF(fileBuf, buf)
           out := buf[0]
           file.close()
      }
      else 
      {
         log.message("start open {pointName.toStr()} failed")
      }
    }
  }
  override void changed(Slot slot)
  {
    super.changed(slot)
    if (slot == Setpoint.url) {
      if (ctx != -1) {
        // Runtime.dataClose(ctx)
        /* file.close() */
        ctx = -1
      }
      if (url.toStr().length() > 0) {
        pointName.clear()
        pointName.copyFromStr(url.toStr())
        file.name = pointName.toStr()
        log.message("changed Setpoint::pointName={pointName.toStr()}")
        // ctx = Runtime.dataOpen(pointName.toStr())
        if (file.open("r")) {
           // Runtime.dataRead(ctx, buf)
           file.in.readBytes(fileBuf, 4, 4)
           dF(fileBuf, buf)
           out := buf[0]
           file.close()
        }
        else 
        {
           log.message("changed open {pointName.toStr()} failed")
        }
      }
    }
  }
  override void stop()
  {
    if (ctx != -1) {
      // Runtime.dataClose(ctx)
        /* file.close() */
      ctx = -1
    }
  }
  override void execute()
  {
    if (ctx != -1 && isSlotLinkToIN()) {
      if (initCnt < 0) {
        initCnt++
        lastIn = in
      } else if (lastIn != in) {
       	 log.message("33333 Setpoint::lastIn=$lastIn and in=$in")
          lastIn = in
          buf[0] = in
          // Runtime.dataWrite(ctx, buf)
          log.message("execute Setpoint::pointName={pointName.toStr()}")
	  if (file.open("w")) {
	       // Runtime.dataRead(ctx, buf)
	       eF(buf, fileBuf)
	       file.out.writeBytes(fileBuf, 1, 4)
	       file.close()
	  }
          else 
          {
             log.message("execute write {pointName.toStr()} failed")
          }
      }
    } else {
      initCnt = -20
    }
    if (ctx != -1) {
        // Runtime.dataRead(ctx, buf)
        // out := buf[0]
        if (file.open("r")) {
           // Runtime.dataRead(ctx, buf)
           file.in.readBytes(fileBuf, 4, 4)
           dF(fileBuf, buf)
           out := buf[0]
           file.close()
        }
        else 
        {
           log.message("execute read {pointName.toStr()} failed")
        }
    }
    if (url.toStr().length() != pointName.toStr().length()) {
      pointName.clear()
      pointName.copyFromStr(url.toStr())
    }
  }

  private bool isSlotLinkToIN()
  {
    for (Link link = linksTo; link != null; link = link.nextTo) {
      Slot slot = type.slot(link.toSlot)
      if (slot == Setpoint.in) {
        return true
      }
    }
    return false
  }

  private int ctx = -1
  private int initCnt = -20
  private float lastIn
  private inline float[1] buf
  private inline byte[8] fileBuf

  File file

  
  native int eF(float[] data, byte[] value)
  native int dF(byte[] data, float[] value)
}
