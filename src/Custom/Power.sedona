@niagaraIcon="module://icons/x16/control/math/add.png"
class Power
  extends Component
{
    ** out is the in1的in2次方
    @readonly property float out
  
    ** input 1 baseNumber
    property float in1 = 1.0
	
	** input 2 exponent
	property float in2 = 1.0

  
  **
  ** Execute is called once every scan.
  **
  virtual override void execute()
  {
	float outSum = 1.0
	
	int exponent = ((int)in2) & 0xFFFF
	
	for(int i = 1; i <= exponent; i++){
		outSum *= in1
	}
    out := outSum
  }
}
